# API base URL (no trailing slash).
# DEV: the LOCAL api (matches apps/api PORT=3000). For `npm run dev` this value
# is forced by apps/web/.env.development.local (which overrides .env). PROD: Render
# sets VITE_API_BASE_URL to the prod API at BUILD time, overriding this file.
# See docs/deployment.md.
VITE_API_BASE_URL=http://localhost:3000

# Firebase web app config (Firebase console > Project settings > Your apps).
# This is the SAME project (market-entry-assessment) the backend uses — there is
# NO separate dev/prod Firebase project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=market-entry-assessment.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=market-entry-assessment
VITE_FIREBASE_APP_ID=
VITE_GOOGLE_OAUTH_CLIENT_ID=

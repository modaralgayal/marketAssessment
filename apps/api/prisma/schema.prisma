generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Submission {
  id                      String           @id @default(cuid())
  createdAt               DateTime         @default(now())
  companyName             String
  country                 String
  website                 String?
  industryCategory        String
  annualRevenue           RevenueBracket?
  annualRevenueCustom     String?
  yearsInBusiness         String?
  currentExportMarkets    String?
  halalCert               YesNoUnsure?
  sfdaStatus              SfdaStatus?
  frozenStorage           FrozenStorage?
  shelfLife               ShelfLife?
  otherCerts              String[]
  otherCertsCustom        String?
  labelLanguages          String?
  productAdaptability     Adaptability?
  brandApproach           BrandApproach?
  leadTimes               String?
  gccCurrentlyActive      Boolean?
  currentGccMarkets       String[]
  gccSituation            String?
  targetMarketPotential   TargetPotential?
  targetMarketPotentialOther String?
  salesChannels           String[]
  channelStrategy         String?
  moq                     String?
  exportContact           Boolean?
  productionCapacity      Capacity?
  contactFullName         String
  contactTitle            String
  contactEmail            String
  contactPhone            String?
  anythingElse            String?
  decision                String?
  evaluatedAt             DateTime?
  explanation             String?
  score                   Float?
  catalogueData           Json?
  catalogueExtractedAt    DateTime?
  catalogueLink           String?
  updatedAt               DateTime         @default(now()) @updatedAt
  files                   SubmissionFile[]
  matches                 ManufacturerMatch[]
  customer                Customer?

  @@index([createdAt])
  @@index([contactEmail])
  @@index([evaluatedAt])
}

model SubmissionFile {
  id           String     @id @default(cuid())
  submissionId String
  storageKey   String
  originalName String
  contentType  String
  sizeBytes    Int
  createdAt    DateTime   @default(now())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model Distributor {
  id                String              @id @default(cuid())
  companyName       String
  cityRegion        String
  channelType       String
  sizeScale         String?
  website           String?
  phone             String?
  email             String?
  contactPerson     String?
  doWeKnowThem      String?
  statusLastContact String?
  description       String?
  dataTier          Int                 @default(3)
  attributes        Json                @default("{}")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  matches           ManufacturerMatch[]

  @@index([dataTier])
}

model ManufacturerMatch {
  id                 String      @id @default(cuid())
  submissionId       String
  distributorId      String
  compatibilityScore Float
  rationale          String
  matchLevel         String
  createdAt          DateTime    @default(now())
  submission         Submission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  distributor        Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([distributorId])
}

// ── Customer ─────────────────────────────────────────────────────────────

enum CustomerStatus {
  QUALIFYING
  ACTIVE
  INACTIVE
  WON
  LOST
}

// Bucketing used by the admin "Customers" tab. Distinct from `customerStatus`
// (the sales pipeline state).
enum CustomerCategory {
  CUSTOMER // a client we have a deal with
  POTENTIAL // products could make a deal; held for distributor/retailer inquiries
  OTHER // may be useful in the future
}

model Customer {
  id                      String           @id @default(cuid())
  submissionId            String?          @unique
  submission              Submission?      @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  // Section 1 - Company Profile
  companyName             String
  country                 String
  website                 String?
  industryCategory        String
  annualRevenue           RevenueBracket?
  annualRevenueCustom     String?
  yearsInBusiness         String?
  currentExportMarkets    String?

  // Section 2 - Products and Operations
  halalCert               YesNoUnsure?
  sfdaStatus              SfdaStatus?
  frozenStorage           FrozenStorage?
  shelfLife               ShelfLife?
  otherCerts              String[]
  otherCertsCustom        String?
  labelLanguages          String?
  productAdaptability     Adaptability?
  brandApproach           BrandApproach?
  leadTimes               String?

  // Section 3 - Target Market
  gccCurrentlyActive      Boolean?
  currentGccMarkets       String[]
  gccSituation            String?
  targetMarketPotential   TargetPotential?
  targetMarketPotentialOther String?
  salesChannels           String[]
  channelStrategy         String?

  // Section 4 - Operational Readiness
  moq                     String?
  exportContact           Boolean?
  productionCapacity      Capacity?

  // Section 5 - Decision-Maker Contact
  contactFullName         String
  contactTitle            String
  contactEmail            String
  contactPhone            String?
  anythingElse            String?

  // Profile (created directly, not via submission conversion)
  logoFileId             String?        // references a CustomerFile id
  contacts               Json?          // ContactPerson[]: { name, position?, phone?, email? }
  productCategory        String?
  companyInfo            String?        // "Information about the company"
  dataPool               Json?          // placeholder section for future use

  // Additional fields
  onboardingDate          DateTime         @default(now())
  customerStatus          CustomerStatus   @default(QUALIFYING)
  category                CustomerCategory @default(POTENTIAL)
  notes                   String?
  catalogueLink           String?

  files                   CustomerFile[]
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  @@index([createdAt])
  @@index([customerStatus])
  @@index([category])
}

// Catalogue / price-list files attached to a customer (mirrors SubmissionFile).
model CustomerFile {
  id           String   @id @default(cuid())
  customerId   String
  storageKey   String
  originalName String
  contentType  String
  sizeBytes    Int
  createdAt    DateTime @default(now())
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

// ── Invites (single-use access tokens that gate the assessment form) ──────

enum InviteStatus {
  PENDING
  USED
  REVOKED
}

model Invite {
  id        String       @id @default(cuid())
  token     String       @unique
  email     String? // optional: the intended recipient of the invite
  status    InviteStatus @default(PENDING)
  purpose   String        @default("OPPORTUNITY") // OPPORTUNITY (→ Submission) | ONBOARDING (→ Customer) | ACCOUNT (→ self-service Account)
  role      String?      // for ACCOUNT invites: BUYER | MANUFACTURER
  account   Account?     @relation(fields: [accountId], references: [id])
  accountId String?      @unique
  createdAt DateTime     @default(now())
  usedAt    DateTime?

  @@index([token])
  @@index([status])
}

// ── Self-service accounts (buyers & manufacturers) ────────────────────────
// Distinct from the admin email-allowlist: an Account is a real, authenticated
// user who owns a profile and opportunity cards. Created via an ACCOUNT invite.

enum AccountRole {
  BUYER
  MANUFACTURER
  ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  DISABLED
}

model Account {
  id          String       @id @default(cuid())
  firebaseUid String       @unique
  email       String
  role        AccountRole
  status      AccountStatus @default(ACTIVE)
  inviteToken String? // the invite token this account was created from
  // Privacy-policy consent tracking (GDPR Art. 7): the version last accepted
  // and when. null until the user first accepts (recorded at sign-up or later).
  privacyAcceptedVersion Int?
  privacyAcceptedAt      DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  manufacturerProfile ManufacturerProfile?
  buyerProfile        BuyerProfile?
  opportunityCards    OpportunityCard[]
  sourcingInquiries   SourcingInquiry[]
  interactions        OpportunityInteraction[]
  conversationParticipants ConversationParticipant[]
  sentMessages            Message[]
  invite              Invite? // the ACCOUNT invite this account was created from

  @@index([firebaseUid])
  @@index([role])
}

// ── Privacy-policy versions ────────────────────────────────────────────────
// A monotonically increasing record of published privacy-policy versions. The
// prose itself lives in the app's static policy page; this table only tracks
// the version number + effective date so we can capture consent and re-prompt
// users when a newer version is published.

model PrivacyPolicyVersion {
  id           Int      @id @default(autoincrement())
  version      Int      @unique
  effectiveDate DateTime @default(now())
  note         String? // short admin note describing what changed
  createdAt    DateTime @default(now())

  @@index([version])
}

enum OpportunitySide {
  BUY // a sourcing need posted by a buyer
  SELL // a product / capability offered by a manufacturer
}

enum OpportunityStatus {
  DRAFT // created, not yet visible to the matchmaking agent
  POSTED // published — visible to the matchmaking agent
  ARCHIVED // taken down
}

// A unit of intent: a manufacturer's offering (SELL) or a buyer's sourcing need
// (BUY). Posting a card (DRAFT → POSTED) is the explicit handoff to the
// matchmaking agent, which reads the POSTED feed and writes back MatchSuggestions.
model OpportunityCard {
  id             String           @id @default(cuid())
  ownerAccountId String
  owner          Account          @relation(fields: [ownerAccountId], references: [id], onDelete: Cascade)
  side           OpportunitySide
  status         OpportunityStatus @default(DRAFT)
  title          String
  summary        String?
  category       String?
  territory      String? // target geography / markets for the card
  channels       String[]         @default([]) // distribution / sales channels
  // Structured offer fields (mirror the model opportunity-card prototype).
  partner        String? // partner type the offer targets (e.g. Distributor, Retailer)
  timing         String? // proposed timing (e.g. "Within six months")
  objective      String? // what the manufacturer is trying to achieve with the card
  moq            String? // initial order / minimum order quantity
  payment        String? // payment terms
  delivery       String? // delivery terms / dispatch location
  rights         String? // distribution rights / exclusivity
  validUntil     String? // proposed terms valid until (ISO date)
  support        String? // marketing / launch support
  version        Int              @default(1) // bumps on every edit (v1, v2, …)
  sources        Json? // catalogue references [{ id?, name }]
  assets         Json? // commercial attachments [{ id?, name }]
  attributes     Json             @default("{}") // legacy free-form fields (kept for old rows)
  publishedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  matchSuggestions MatchSuggestion[] @relation("cardA")
  matchSuggestionsB MatchSuggestion[] @relation("cardB")
  interactions OpportunityInteraction[]

  @@index([ownerAccountId])
  @@index([status])
  @@index([side])
}

enum MatchSuggestionStatus {
  NEW
  REVIEWED
  DISMISSED
  ACCEPTED
}

// Written by the matchmaking agent (server-to-server). Surfaced on both
// dashboards so each party can see incoming matches on their cards.
model MatchSuggestion {
  id         String              @id @default(cuid())
  cardAId    String
  cardA      OpportunityCard     @relation("cardA", fields: [cardAId], references: [id], onDelete: Cascade)
  cardBId    String
  cardB      OpportunityCard     @relation("cardB", fields: [cardBId], references: [id], onDelete: Cascade)
  score      Float
  rationale  String?
  status     MatchSuggestionStatus @default(NEW)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([cardAId])
  @@index([cardBId])
}

// ── Opportunity interactions (buyer interest + manufacturer engagement) ─────
// A single table records how each buyer has interacted with a given marketplace
// card: viewed / saved / expressed interest / declined / referred. Powers the
// buyer's "your activity" filters and the manufacturer's "Buyer engagement" feed.

enum OpportunityInteractionStatus {
  NEW // no stated interest yet
  VIEWED
  SAVED
  INTERESTED
  DECLINED
  REFERRED
}

// ── Conversations (buyer ⇄ manufacturer messaging) ─────────────────────────
// A conversation is seeded when a buyer expresses interest in a manufacturer's
// opportunity card. Its first message is the buyer's "interest note"; the two
// parties then keep talking on-platform.

enum ConversationType {
  INTEREST // seeded from an interest expression on a card
  DIRECT // started manually (future)
}

enum MessageKind {
  INTEREST_NOTE // the seeded first message (buyer's interest note)
  MESSAGE // normal two-way text
  SYSTEM // system event
}

model OpportunityInteraction {
  id               String                     @id @default(cuid())
  cardId           String
  card             OpportunityCard            @relation(fields: [cardId], references: [id], onDelete: Cascade)
  accountId        String // the buyer viewing / acting
  account          Account                    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  status           OpportunityInteractionStatus @default(NEW)
  viewedAt         DateTime?
  lastActivityAt    DateTime?
  linkedInquiryId  String? // SourcingInquiry this interest was expressed from
  referralNote     String?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@unique([cardId, accountId])
  @@index([cardId])
  @@index([accountId])
  @@index([status])
}

// ── Conversations (buyer ⇄ manufacturer messaging) ───────────────────────────
// Seeded when a buyer expresses interest in a manufacturer's opportunity card;
// the first message is the buyer's "interest note". Parties continue on-platform.

model Conversation {
  id            String           @id @default(cuid())
  type          ConversationType @default(INTEREST)
  subject       String?
  // Linkage back to the entity that seeded the conversation (for dedup + context)
  seedCardId    String?
  seedInquiryId String?
  lastMessageAt DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  participants  ConversationParticipant[]
  messages      Message[]

  @@index([updatedAt])
  @@index([seedCardId])
}

model ConversationParticipant {
  id             String         @id @default(cuid())
  conversationId String
  conversation   Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  role           AccountRole
  createdAt      DateTime       @default(now())

  @@unique([conversationId, accountId])
  @@index([accountId])
}

model Message {
  id              String       @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderAccountId String?
  sender          Account?     @relation(fields: [senderAccountId], references: [id], onDelete: SetNull)
  kind            MessageKind  @default(MESSAGE)
  body            String
  createdAt       DateTime     @default(now())
  attachments     MessageFile[]

  @@index([conversationId, createdAt])
}

model MessageFile {
  id           String   @id @default(cuid())
  messageId    String
  message      Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  storageKey   String
  originalName String
  contentType  String
  sizeBytes    Int
  createdAt    DateTime @default(now())

  @@index([messageId])
}

// ── Activity feed (Overview "Recent activity" / "Recent buyer activity") ────

model ActivityEvent {
  id             String   @id @default(cuid())
  accountId      String // owner whose dashboard shows it
  actorAccountId String? // the account that triggered it (e.g. a buyer)
  type           String // inquiry_created | card_published | interest_expressed | viewed | shared | proposal_received
  payload        Json     @default("{}")
  createdAt      DateTime @default(now())

  @@index([accountId, createdAt])
}

// ── Access requests (public "request a user creation" queue) ────────────────
// A visitor who wants a buyer/manufacturer account submits one of these. An
// admin approves it, which mints an ACCOUNT invite and emails the link; the
// visitor then bootstraps their Account from that invite.

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model AccessRequest {
  id           String              @id @default(cuid())
  name         String
  email        String
  company      String?
  intendedRole AccountRole          // BUYER | MANUFACTURER (stated intent; admin may override)
  message      String?
  status       AccessRequestStatus  @default(PENDING)
  inviteToken  String?              // set on approval → links to Invite.token
  reviewedBy   String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([status])
  @@index([email])
}

// ── Manufacturer profile (self-service; mirrors the legacy Customer fields) ─

model ManufacturerProfile {
  id          String  @id @default(cuid())
  accountId   String  @unique
  account     Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // Section 1 - Company Profile
  companyName          String
  country              String
  website              String?
  industryCategory     String
  annualRevenue        RevenueBracket?
  annualRevenueCustom  String?
  yearsInBusiness      String?
  currentExportMarkets String?

  // Section 2 - Products and Operations
  halalCert            YesNoUnsure?
  sfdaStatus           SfdaStatus?
  frozenStorage        FrozenStorage?
  shelfLife            ShelfLife?
  otherCerts           String[]
  otherCertsCustom     String?
  labelLanguages       String?
  productAdaptability  Adaptability?
  brandApproach        BrandApproach?
  leadTimes            String?

  // Section 3 - Target Market
  gccCurrentlyActive  Boolean?
  currentGccMarkets   String[]
  gccSituation        String?
  targetMarketPotential TargetPotential?
  targetMarketPotentialOther String?
  salesChannels       String[]
  channelStrategy     String?

  // Section 4 - Operational Readiness
  moq              String?
  exportContact    Boolean?
  productionCapacity Capacity?

  // Section 5 - Decision-Maker Contact
  contactFullName  String
  contactTitle     String
  contactEmail     String
  contactPhone     String?
  anythingElse     String?

  // Profile (created directly, not via submission conversion)
  contacts      Json? // ContactPerson[]: { name, position?, phone?, email? }
  productCategory String?
  companyInfo   String?
  logoFileId    String?

  // Expanded profile (reference prototype)
  exportCount        Int? // number of export markets
  topMarkets        String? // conditional on exportCount > 0
  knownFor           String?
  pictures           String?
  logistics          String?
  usp               String?
  branding           String? // "brandLed" | "shared" | "tradeSupport" | "priceLed"
  privateLabel       String? // "yes" | "no" | "considering"
  certs             String[] @default([]) // Halal | BRCGS | IFS | FSSC | ISO | HACCP | Organic | Other | None
  catalogueCoverage  Json? // { products: bool, prices: bool, ... }
  catalogueFileId    String? // → ManufacturerFile (uploaded catalogue / price list)

  // Back-relation to uploaded catalogue / price-list documents.
  files             ManufacturerFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
}

// Manufacturer catalogue / price-list document (mirrors BuyerFile).
model ManufacturerFile {
  id                  String            @id @default(cuid())
  manufacturerProfileId String
  manufacturerProfile  ManufacturerProfile @relation(fields: [manufacturerProfileId], references: [id], onDelete: Cascade)
  // kind: "pdf" = uploaded file (storageKey set); "link" = external URL (url set).
  kind                String            @default("pdf")
  storageKey          String? // present for kind = "pdf"
  url                 String? // present for kind = "link"
  originalName        String
  contentType          String
  sizeBytes            Int
  createdAt            DateTime          @default(now())

  @@index([manufacturerProfileId])
}

// ── Buyer profile (self-service) ───────────────────────────────────────────

enum BuyerType {
  IMPORTER_DISTRIBUTOR
  RETAILER
}

model BuyerProfile {
  id        String  @id @default(cuid())
  accountId String  @unique
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  buyerType        BuyerType
  companyName      String
  country          String
  website          String?
  // Categories & portfolio
  categories       String[] @default([])
  portfolioInfo    String? // "Information about the company"
  // Sourcing preferences / needs
  sourcingNeeds    String?
  targetMarkets    String[] @default([]) // GCC markets of interest
  // Decision-maker contact
  contactFullName  String
  contactTitle     String
  contactEmail     String
  contactPhone     String?
  contacts         Json? // ContactPerson[]: { name, position?, phone?, email? }
  logoFileId       String?

  // Expanded profile (reference prototype) — Company subsection
  tradingName        String?
  hqCountry          String?
  hqCity             String?
  operatingCountries  String[] @default([])
  roles              String[] @default([]) // RETAILER | IMPORTER_DISTRIBUTOR (selectable; complements buyerType)
  // Portfolio
  portfolioProducts  String?
  privateLabel       String? // "yes" | "no"
  privateLabelName   String?
  privateLabelCategories String?
  portfolioFiles     BuyerFile[]
  // Importer & distributor profile
  distributionRole       String?
  warehouse              String?
  warehouseArrangement   String?
  storage                String[] @default([])
  vehicles               String?
  vehicleArrangement     String?
  channels               String[] @default([])
  channelPercentages      Json?
  channelBasis           String?
  salesPoints            Int?
  salesReachMode         String?
  distributionGeography   String?
  expandPortfolio         String?
  expansionProducts       String?
  distributionProductType String?
  // Retailer profile
  retailFormats           String[] @default([])
  storeCount              Int?
  retailGeography         String?
  purchasingStructure     String?
  purchasingOffice        String?
  purchasingOutsourced    String?
  purchasingSubsidiary    String?
  purchasingSubsidiaryName String?
  retailSupply            String? // "directImport" | "localSupplier" | "both"
  directImportPercent     Float?
  localSupplierPercent    Float?
  retailMixBasis          String?
  assortmentPlan          String?
  retailExpansionProducts String?
  retailProductType       String?
  retailDelivery          String?
  // catch-all for deep conditional fields
  details                Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
}

// Buyer portfolio / assortment documents (mirrors CustomerFile).
model BuyerFile {
  id           String       @id @default(cuid())
  buyerProfileId String
  buyerProfile  BuyerProfile @relation(fields: [buyerProfileId], references: [id], onDelete: Cascade)
  storageKey   String
  originalName String
  contentType  String
  sizeBytes    Int
  createdAt    DateTime     @default(now())

  @@index([buyerProfileId])
}

// ── Sourcing inquiries (buyer-authored sourcing needs) ──────────────────────
// Distinct from the marketplace `OpportunityCard` (side=BUY). A SourcingInquiry
// is the buyer's richer "buying brief" that the dashboards surface and the
// matchmaking agent pairs against manufacturer SELL cards.

enum SourcingInquiryStatus {
  DRAFT
  OPEN
  PAUSED
  CLOSED
}

model SourcingInquiry {
  id          String   @id @default(cuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  title       String
  products    String
  productType String // BRANDED | PRIVATE_LABEL | EITHER
  market      String? // target country / territory
  channels    String[] @default([])
  priceTier   String?
  targetPrice  String?
  timeframe   String?
  quantity    String?
  essential   String?
  negotiable  String?
  status      SourcingInquiryStatus @default(DRAFT)
  attributes  Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  briefs      SourcingInquiryFile[]

  @@index([accountId])
  @@index([status])
  @@index([market])
}

// Buying-brief attachments (mirrors SubmissionFile / CustomerFile).
model SourcingInquiryFile {
  id           String          @id @default(cuid())
  inquiryId    String
  inquiry      SourcingInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  storageKey   String
  originalName String
  contentType  String
  sizeBytes    Int
  createdAt    DateTime       @default(now())

  @@index([inquiryId])
}

// ── Report access requests (public "Request a Report" form) ──────────────

model ReportRequest {
  id        String   @id @default(cuid())
  subject   String
  message   String
  email     String
  consent   Boolean  @default(false)
  status    String   @default("NEW")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ── Leads (public marketing-site lead forms) ───────────────────────────────
// A single Lead model holds every marketing-site lead, discriminated by `kind`.
// Shared columns are typed; form-specific fields live on the relevant variant
// and `attributes` is a JSON catch-all for anything not yet modelled. Files
// (e.g. the SOURCING product document) live in `LeadFile`.

enum LeadKind {
  EXPORTING
  SOURCING
  ORGANIZATION
}

model Lead {
  id              String   @id @default(cuid())
  kind            LeadKind
  sourcePage      String? // which route submitted (e.g. "/for-sourcing")
  // shared contact
  fullName        String?
  email           String?
  phone           String?
  // exporting-specific
  companyName     String?
  country         String?
  website         String?
  product         String? // single product line (exporting)
  targetMarket    String[] @default([]) // EXPORTING: array of ISO country codes (export-only)
  // organization-specific
  organizationName String?
  organizationType String?
  jobTitle        String?
  support         String[] @default([]) // ORGANIZATION: selected support options
  priorities      String?
  // sourcing-specific
  sourceCountries String[] @default([]) // SOURCING: "where you source from"
  products        String? // SOURCING: textarea
  details         String? // SOURCING: textarea
  // product document: REQUIRED for SOURCING — link OR upload (not both stored as mandatory)
  productDocumentLink String?
  attributes      Json     @default("{}") // any future/extra fields
  consent         Boolean  @default(false)
  status          String   @default("NEW")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  files           LeadFile[]

  @@index([kind])
  @@index([createdAt])
  @@index([status])
}

// Mirrors SubmissionFile — used by SOURCING's productDocument upload.
model LeadFile {
  id           String   @id @default(cuid())
  leadId       String

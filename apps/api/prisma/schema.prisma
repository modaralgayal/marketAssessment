generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Submission {
  id                      String           @id @default(cuid())
  createdAt               DateTime         @default(now())
  companyName             String
  country                 String
  website                 String?
  industryCategory        String
  annualRevenue           RevenueBracket?
  annualRevenueCustom     String?
  yearsInBusiness         String?
  currentExportMarkets    String?
  halalCert               YesNoUnsure?
  sfdaStatus              SfdaStatus?
  frozenStorage           FrozenStorage?
  shelfLife               ShelfLife?
  otherCerts              String[]
  otherCertsCustom        String?
  labelLanguages          String?
  productAdaptability     Adaptability?
  brandApproach           BrandApproach?
  leadTimes               String?
  gccCurrentlyActive      Boolean?
  currentGccMarkets       String[]
  gccSituation            String?
  targetMarketPotential   TargetPotential?
  targetMarketPotentialOther String?
  salesChannels           String[]
  channelStrategy         String?
  moq                     String?
  exportContact           Boolean?
  productionCapacity      Capacity?
  contactFullName         String
  contactTitle            String
  contactEmail            String
  contactPhone            String?
  anythingElse            String?
  decision                String?
  evaluatedAt             DateTime?
  explanation             String?
  score                   Float?
  catalogueData           Json?
  catalogueExtractedAt    DateTime?
  updatedAt               DateTime         @default(now()) @updatedAt
  files                   SubmissionFile[]
  matches                 ManufacturerMatch[]
  customer                Customer?

  @@index([createdAt])
  @@index([contactEmail])
  @@index([evaluatedAt])
}

model SubmissionFile {
  id           String     @id @default(cuid())
  submissionId String
  storageKey   String
  originalName String
  contentType  String
  sizeBytes    Int
  createdAt    DateTime   @default(now())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model Distributor {
  id                String              @id @default(cuid())
  companyName       String
  cityRegion        String
  channelType       String
  sizeScale         String?
  website           String?
  phone             String?
  email             String?
  contactPerson     String?
  doWeKnowThem      String?
  statusLastContact String?
  description       String?
  dataTier          Int                 @default(3)
  attributes        Json                @default("{}")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  matches           ManufacturerMatch[]

  @@index([dataTier])
}

model ManufacturerMatch {
  id                 String      @id @default(cuid())
  submissionId       String
  distributorId      String
  compatibilityScore Float
  rationale          String
  matchLevel         String
  createdAt          DateTime    @default(now())
  submission         Submission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  distributor        Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([distributorId])
}

// ── Customer ─────────────────────────────────────────────────────────────

enum CustomerStatus {
  QUALIFYING
  ACTIVE
  INACTIVE
  WON
  LOST
}

model Customer {
  id                      String           @id @default(cuid())
  submissionId            String?          @unique
  submission              Submission?      @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  // Section 1 - Company Profile
  companyName             String
  country                 String
  website                 String?
  industryCategory        String
  annualRevenue           RevenueBracket?
  annualRevenueCustom     String?
  yearsInBusiness         String?
  currentExportMarkets    String?

  // Section 2 - Products and Operations
  halalCert               YesNoUnsure?
  sfdaStatus              SfdaStatus?
  frozenStorage           FrozenStorage?
  shelfLife               ShelfLife?
  otherCerts              String[]
  otherCertsCustom        String?
  labelLanguages          String?
  productAdaptability     Adaptability?
  brandApproach           BrandApproach?
  leadTimes               String?

  // Section 3 - Target Market
  gccCurrentlyActive      Boolean?
  currentGccMarkets       String[]
  gccSituation            String?
  targetMarketPotential   TargetPotential?
  targetMarketPotentialOther String?
  salesChannels           String[]
  channelStrategy         String?

  // Section 4 - Operational Readiness
  moq                     String?
  exportContact           Boolean?
  productionCapacity      Capacity?

  // Section 5 - Decision-Maker Contact
  contactFullName         String
  contactTitle            String
  contactEmail            String
  contactPhone            String?
  anythingElse            String?

  // Additional fields
  onboardingDate          DateTime         @default(now())
  customerStatus          CustomerStatus   @default(QUALIFYING)
  notes                   String?

  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  @@index([createdAt])
  @@index([customerStatus])
}

// ── Invites (single-use access tokens that gate the assessment form) ──────

enum InviteStatus {
  PENDING
  USED
  REVOKED
}

model Invite {
  id        String       @id @default(cuid())
  token     String       @unique
  email     String? // optional: the intended recipient of the invite
  status    InviteStatus @default(PENDING)
  createdAt DateTime     @default(now())
  usedAt    DateTime?

  @@index([token])
  @@index([status])
}

// ── Report access requests (public "Request a Report" form) ──────────────

model ReportRequest {
  id        String   @id @default(cuid())
  subject   String
  message   String
  email     String
  status    String   @default("NEW")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum RevenueBracket {
  R1_5M
  R5_20M
  R20_50M
  R50_100M
  R100_200M
  R200M_PLUS
  R300M_PLUS
  R400M_PLUS
  R500M_1B
  R1B_PLUS
  CUSTOM
}

enum YesNoUnsure {
  YES
  IN_PROGRESS
  NO
  UNSURE
}

enum FrozenStorage {
  YES
  NO
}

enum ShelfLife {
  SHORT
  MEDIUM
  LONG
}

enum BrandApproach {
  BRAND_LED
  SHARED
  TRADE_SUPPORT
  PRICE_LED
}

enum TargetPotential {
  KSA
  UAE
  BOTH
  UNSURE
  OTHER
}

enum Capacity {
  YES
  PARTIAL
  NO
}

enum Adaptability {
  YES
  PARTIAL
  NO
}

enum SfdaStatus {
  REGISTERED
  IN_PROCESS
  NOT_YET
  UNSURE
}

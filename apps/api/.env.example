# ── Core (DEV defaults — see docs/deployment.md) ──────────────────────────
# In LOCAL DEV this project's database is Supabase (cloud Postgres). The prod
# database is a SEPARATE Render Postgres whose DATABASE_URL is set in the Render
# dashboard for the `mea-api` service — NOT here. Both share the same Prisma
# schema (kept in sync via committed migrations + `db:deploy`) but hold their
# OWN rows. Copy this file to `.env` and fill in real values.
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173,http://localhost:3000

# DEV database = Supabase. Replace <project> with your Supabase project ref.
# Prod uses a different DATABASE_URL (Render Postgres) configured in the Render
# dashboard — never point this at prod for local dev.
DATABASE_URL=postgresql://postgres:postgres@db.<project>.supabase.co:5432/postgres?sslmode=require

# Comma-separated admin Google emails allowed into the admin dashboard
ADMIN_EMAILS=you@example.com

# ── Firebase Admin (base64 of the service-account JSON) ───────────────────
# The SAME Firebase project (`market-entry-assessment`) is used for DEV AND prod
# — there is no separate dev/prod Firebase project.
# Generate:  base64 -w0 service-account.json   (Linux)  /  base64 -i service-account.json (macOS)
FIREBASE_SERVICE_ACCOUNT_B64=

# ── Cloudflare R2 (file storage) ──────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# ── AI (scoring / matching / catalogue extraction) ────────────────────────
CLAUDE_API_KEY=

# ── Optional integrations ─────────────────────────────────────────────────
GOOGLE_SHEET_ID=          # server-side distributor import
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
REPORT_RECIPIENT_EMAIL=
